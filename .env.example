# ==========================================
# rconfig Fortigate Bridge - 環境變數範本
# ==========================================

# ============ SFTP 設定 ============
SFTP_PORT=2222

# ============ rconfig 路徑設定 ============
# rconfig 安裝路徑（在 rconfig 主機上的絕對路徑）
RCONFIG_PATH=/var/www/html/rconfig

# ============ rconfig 資料庫設定 ============
RCONFIG_DB_HOST=localhost
RCONFIG_DB_PORT=3306
RCONFIG_DB_NAME=rconfig
RCONFIG_DB_USER=pcc_rconfig
RCONFIG_DB_PASSWORD=CHANGE_ME_TO_ACTUAL_PASSWORD

# ============ TACACS LDAP 設定（audit 模組）============
# audit/main.py 查詢 TACACS 群組成員時使用
# LDAP Server 與 rconfig 為不同主機，需確認 stwrconfig6 → ldap.pouchen.com:636 網路可達
TACACS_LDAP_BIND_PW=CHANGE_ME_TO_ACTUAL_PASSWORD

# ============ 日誌設定 ============
LOG_LEVEL=INFO
